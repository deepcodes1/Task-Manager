# =========================================================================
# 1. BACKEND REST API ENDPOINT URL
# =========================================================================
# The address where your secure FastAPI backend server is running.
# The React client will send all CRUD HTTP network calls to this URL.
VITE_API_URL=http://localhost:8000/api

# =========================================================================
# 2. IBM APP ID CONFIGURATION (React Client Side)
# =========================================================================
# Used to authenticate users directly from the browser (OIDC Implicit Flow).
# -> VITE_APP_ID_CLIENT_ID: Must match the APP_ID_CLIENT_ID defined in the backend.
# -> VITE_APP_ID_SERVER_URL: Must match the APP_ID_SERVER_URL defined in the backend.
# If these variables are empty or not configured, you can use "Developer Bypass Mode" to test locally.
VITE_APP_ID_CLIENT_ID=64a62eda-ae7b-4cd1-9af8-7032fca2700b
VITE_APP_ID_SERVER_URL=https://au-syd.appid.cloud.ibm.com/oauth/v4/874ec0e0-e4d5-4160-ac3e-2b9476a0785e
